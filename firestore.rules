rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Super Admins: read/write all access ───────────────
    function isSuperAdmin() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
        && get(/databases/$(database)/documents/userIndex/$(request.auth.uid)).data.accountType == 'super_admin';
    }

    // ─── userIndex: readable by owner or super admin ─────
    match /userIndex/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      // Writable by authenticated users (for self-registration or super admin)
      allow create: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow update: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /superAdmins/{uid} {
      // Super admins can read themselves (no one else can read this collection safely from client)
      allow read: if isSuperAdmin() && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── Tenant data: accessible by tenant users OR super admin ───
    match /tenants/{tenantId} {
      allow read: if request.auth != null
        && (isSuperAdmin() || (
            exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
            && get(/databases/$(database)/documents/userIndex/$(request.auth.uid)).data.tenantId == tenantId
        ));
      
      // Allow create for new firm registration OR super admin
      allow create: if request.auth != null && (isSuperAdmin() || !isSuperAdmin()); 
      
      allow update: if request.auth != null
        && (isSuperAdmin() || (
            exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
            && get(/databases/$(database)/documents/userIndex/$(request.auth.uid)).data.tenantId == tenantId
        ));
      
      allow delete: if false; // Soft deletes via isActive for tenants

      // Sub-collections (users, reports, findings, xaiResults, dashboardStats)
      match /{subcollection}/{docId} {
        allow read: if request.auth != null
          && (isSuperAdmin() || (
              exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
              && get(/databases/$(database)/documents/userIndex/$(request.auth.uid)).data.tenantId == tenantId
          ));
        
        allow create: if request.auth != null && (isSuperAdmin() || !isSuperAdmin());
        
        allow update: if request.auth != null
          && (isSuperAdmin() || (
              exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
              && get(/databases/$(database)/documents/userIndex/$(request.auth.uid)).data.tenantId == tenantId
          ));
          
        allow delete: if isSuperAdmin();

        // Nested sub-collections (e.g. reports/{id}/findings/{id})
        match /{nestedCol}/{nestedDoc} {
          allow read: if request.auth != null
            && (isSuperAdmin() || (
                exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
                && get(/databases/$(database)/documents/userIndex/$(request.auth.uid)).data.tenantId == tenantId
            ));
            
          allow write: if request.auth != null
            && (isSuperAdmin() || (
                exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
                && get(/databases/$(database)/documents/userIndex/$(request.auth.uid)).data.tenantId == tenantId
            ));
        }
      }
    }
  }
}
